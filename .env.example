# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Confluence Data Center personal access token (Bearer). Required for sync.
CONFLUENCE_PAT=

# Optional overrides for config.toml values.
# CONFLUENCE_BASE_URL=https://confluence.example.com
# CONFLUENCE_MIRROR_DSN=postgresql:///confluence_mirror

# Optional: path to a PEM bundle containing your corporate root CA.
# CONFLUENCE_CA_BUNDLE=/Users/you/certs/corp-root.pem
